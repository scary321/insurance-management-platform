# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-jwt-secret-too

# PostgreSQL (per project spec)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insurance_db

# JWT token lifetime (hours)
JWT_ACCESS_HOURS=8

# Uploads
MAX_CONTENT_MB=16

# Production: restrict browser origins (comma-separated). Dev default is "*".
# e.g. CORS_ORIGINS=https://your-frontend.vercel.app
CORS_ORIGINS=*
